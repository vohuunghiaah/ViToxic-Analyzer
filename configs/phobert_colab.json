{
  "model_name": "vinai/phobert-base",
  "revision": "main",
  "train_path": "data/processed/train_decontaminated.csv",
  "validation_path": "data/processed/validation.csv",
  "segmenter_dir": "resources/vncorenlp",
  "cache_dir": "data/cache/segmented",
  "output_dir": "outputs/stage2/runs/phobert_colab",
  "max_length": 128,
  "batch_size": 8,
  "eval_batch_size": 16,
  "gradient_accumulation_steps": 4,
  "epochs": 5,
  "learning_rate": 0.00002,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "dropout": 0.1,
  "patience": 2,
  "min_delta": 0.0001,
  "max_grad_norm": 1.0,
  "freeze_epochs": 0,
  "gradient_checkpointing": true,
  "imbalance": "weighted_loss",
  "precision": "fp16",
  "device": "cuda",
  "num_workers": 0,
  "seed": 42,
  "selection_metric": "macro_f1"
}
